# GroundGraph TypeScript Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://groundgraph:change-me-local-only@127.0.0.1:5432/groundgraph
POSTGRES_USER=groundgraph
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=groundgraph
POSTGRES_PORT=5432

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-only
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# S3/MinIO
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
S3_BUCKET_RAW=groundgraph-raw
S3_BUCKET_PROCESSED=groundgraph-processed
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=ground-graph-ts
OTEL_ENABLED=true

# Phoenix
PHOENIX_DB=phoenix
PHOENIX_POSTGRES_HOST=127.0.0.1
PHOENIX_POSTGRES_PORT=5432

# Prometheus & Grafana
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-local-only
GRAFANA_URL=http://127.0.0.1:3001

# Model Provider (OpenRouter recommended for free tier)
# OpenRouter API key from https://openrouter.ai/keys
OPENAI_API_KEY=your-openrouter-api-key

# LLM Provider: "openrouter" (default, free models available) or "openai"
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.0-flash-thinking-exp:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Embedding Provider: "openai" (free tier: text-embedding-3-small)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=

# Web UI
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
