{
  "name": "ground-graph-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid Agentic GraphRAG system with vertical knowledge graph, horizontal workflow graph, and queryable execution graph",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "oxfmt --write src apps tests",
    "format:check": "oxfmt --check src apps tests",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:architecture": "vitest run tests/architecture",
    "test:unit": "vitest run tests/unit --coverage",
    "test:component": "vitest run tests/component --maxWorkers 1",
    "test:watch": "vitest",
    "test:unit:coverage": "vitest run tests/unit --coverage --coverage.reporters=html --coverage.reporters=lcov --coverage.reporters=text-summary",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:architecture && pnpm test:unit",
    "check:ci": "pnpm install --frozen-lockfile && pnpm check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.59",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ai": "^7.0.93",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "fastify-healthcheck": "^5.1.0",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/typescript-estree": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
