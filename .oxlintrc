{
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-native-nonconstructor": "error",
    "no-script-url": "error",
    "no-undef": "error",
    "no-unused-vars": "error",
    "no-with": "error",
    "prefer-const": "error",
    "no-var": "error"
  },
  "settings": {
    "target": "ES2022"
  }
}
