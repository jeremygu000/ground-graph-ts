{
  "name": "m6-hybrid-graphrag",
  "version": "0.1.0",
  "description": "Golden evaluation dataset for the M6 hybrid GraphRAG retrieval. Each case exercises relational or multi-hop queries that benefit from graph traversal combined with vector/fulltext retrieval. The dataset covers multi-hop, path-finding, entity-resolution, temporal, ACL, and hybrid fusion scenarios.",
  "embedding_model": "text-embedding-3-small",
  "embedding_dimension": 1536,
  "reranker_model": "lexical-blend",
  "generator_model": "gpt-4o-mini",
  "cases": [
    {
      "id": "hg-001",
      "type": "multi-hop",
      "tags": ["positive", "two-hop", "graph-plus-vector"],
      "question": "What services does the team that owns the PostgreSQL adapter work on?",
      "tenantId": "00000000-0000-4000-8000-000000000001",
      "principalId": "00000000-0000-4000-8000-0000000000a1",
      "expectedStatus": "answered",
      "expectedAnswer": "The team that owns the PostgreSQL adapter works on the ingestion-worker and evaluation-runner services.",
      "requiredClaimText": "ingestion-worker",
      "forbiddenClaimText": [],
      "expectedEntities": ["PostgreSQL adapter", "ingestion-worker", "evaluation-runner"],
      "expectedPaths": [
        {
          "from": "PostgreSQL adapter",
          "predicate": "owned_by",
          "to": "Team A"
        },
        {
          "from": "Team A",
          "predicate": "works_on",
          "to": "ingestion-worker"
        }
      ],
      "expectedEvidenceChunkIds": []
    },
    {
      "id": "hg-002",
      "type": "path-finding",
      "tags": ["positive", "path", "graph-only"],
      "question": "Show the relationship chain from the API gateway to the database.",
      "tenantId": "00000000-0000-4000-8000-000000000001",
      "principalId": "00000000-0000-4000-8000-0000000000a1",
      "expectedStatus": "answered",
      "expectedAnswer": "API gateway → load balancer → api service → PostgreSQL adapter → PostgreSQL",
      "requiredClaimText": "PostgreSQL",
      "forbiddenClaimText": [],
      "expectedEntities": ["API gateway", "load balancer", "api service", "PostgreSQL adapter", "PostgreSQL"],
      "expectedPaths": [
        {
          "from": "API gateway",
          "predicate": "connects_to",
          "to": "load balancer"
        },
        {
          "from": "load balancer",
          "predicate": "forwards_to",
          "to": "api service"
        },
        {
          "from": "api service",
          "predicate": "uses",
          "to": "PostgreSQL adapter"
        },
        {
          "from": "PostgreSQL adapter",
          "predicate": "connects_to",
          "to": "PostgreSQL"
        }
      ],
      "expectedEvidenceChunkIds": []
    },
    {
      "id": "hg-003",
      "type": "entity-resolution",
      "tags": ["positive", "disambiguation", "vector-plus-graph"],
      "question": "Who owns the service that uses PostgreSQL and what else do they own?",
      "tenantId": "00000000-0000-4000-8000-000000000001",
      "principalId": "00000000-0000-4000-8000-0000000000a1",
      "expectedStatus": "answered",
      "expectedAnswer": "Team A owns the PostgreSQL adapter service. They also own the ingestion-worker and evaluation-runner.",
      "requiredClaimText": "Team A",
      "forbiddenClaimText": [],
      "expectedEntities": ["PostgreSQL adapter", "Team A", "ingestion-worker", "evaluation-runner"],
      "expectedPaths": [],
      "expectedEvidenceChunkIds": []
    },
    {
